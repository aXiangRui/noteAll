{
  "version": 4,
  "configurations": [
    {
      // 首选：由 CMake Tools 自动生成 IntelliSense 配置
      "name": "MSVC x64 (C++20)",
      "configurationProvider": "ms-vscode.cmake-tools",

      // 下面几项是 CMake Tools 缺席时的兜底
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/third_party"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
